# PostHog Product Analytics for the BuzzBuzz website (static HTML).
# This site has no bundler, so production reads posthog-config.js.
# Keep the public project key (phc_...) there. Do not put personal keys (phx_...) in the site.

POSTHOG_PROJECT_API_KEY=phc_your_project_api_key
POSTHOG_HOST=https://us.i.posthog.com
